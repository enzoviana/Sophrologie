# No frontend env vars by default: API calls use relative /api paths via the Vite
# proxy. Add VITE_-prefixed vars here if the app ever needs build-time config.
# API Base URL
# In development: uses relative "/api" path (proxied by Vite to backend)
# In production: set to your deployed backend URL
VITE_API_BASE_URL=https://sophrologie.onrender.com/api
